# ─── Base de datos (Neon) ─────────────────────────────────────────
# Usar la URL con pooler para DATABASE_URL y la directa para DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/eliteos?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/eliteos?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────
JWT_SECRET="genera-un-string-aleatorio-largo-aqui"
JWT_EXPIRES_IN="7d"

# ─── Servidor ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# En producción: URL de Vercel. En dev: localhost
FRONTEND_URL="http://localhost:3000"
